{
  "compilerOptions": {
    "allowJs": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["convex/**/*.ts", "vitest.config.ts"]
}
