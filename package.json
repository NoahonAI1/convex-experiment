{
  "name": "convex-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --sequential --workspaces build",
    "dev": "bun run --parallel --workspaces dev",
    "dev:backend": "bun run --filter @repo/backend dev",
    "dev:web": "bun run --filter @repo/web dev",
    "test": "bun run --sequential --workspaces test",
    "typecheck": "bun run --sequential --workspaces typecheck"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "trustedDependencies": ["core-js", "esbuild"]
}
